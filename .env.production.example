ELECTROTRACE_ENV=production
ELECTROTRACE_OCR_PROVIDER=paddle
ELECTROTRACE_SEED_DEMO=false
ELECTROTRACE_AUTH_REQUIRED=true
ELECTROTRACE_DB=/app/data/electrotrace.db
ELECTROTRACE_UPLOAD_DIR=/app/data/uploads
ELECTROTRACE_SESSION_HOURS=8
ELECTROTRACE_RATE_LIMIT=600
ELECTROTRACE_ALLOWED_HOSTS=trace.example.internal
# 仅首次启动使用，创建管理员后应从部署密钥中移除。
ELECTROTRACE_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
ELECTROTRACE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secret-of-at-least-12-characters
ELECTROTRACE_MAX_LOGIN_ATTEMPTS=5
ELECTROTRACE_LOGIN_LOCK_MINUTES=15
ELECTROTRACE_AUDIT_HMAC_KEY=replace-with-a-stable-high-entropy-audit-key
